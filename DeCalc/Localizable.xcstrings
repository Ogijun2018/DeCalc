    "T: time in seconds, M: height or distance in centimeters, D: distance in meters. Points are rounded down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T: Zeit in Sekunden, M: Höhe oder Weite in Zentimetern, D: Weite in Metern. Punkte werden abgerundet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T: tiempo en segundos, M: altura o distancia en centímetros, D: distancia en metros. Los puntos se redondean hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T : temps en secondes, M : hauteur ou distance en centimètres, D : distance en mètres. Les points sont arrondis à l’entier inférieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T: tempo in secondi, M: altezza o distanza in centimetri, D: distanza in metri. I punti vengono arrotondati per difetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T: タイム（秒）、M: 高さ・距離（cm）、D: 距離（m）。得点の小数点以下は切り捨てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T: 기록(초), M: 높이 또는 거리(cm), D: 거리(m). 점수의 소수점 이하는 버립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T：时间（秒），M：高度或距离（厘米），D：距离（米）。得分向下取整。"
          }
        }
      }
    },
